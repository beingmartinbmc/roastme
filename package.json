{
  "name": "roastcode",
  "version": "2.0.0",
  "description": "Because your code deserves tough love. A CLI tool that humorously roasts code files, commit messages, and diffs with multiple AI engines.",
  "main": "bin/roastme.js",
  "bin": {
    "roastcode": "bin/roastme.js"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high || true",
    "pack:dry-run": "npm pack --dry-run",
    "start": "node bin/roastme.js",
    "dev": "node bin/roastme.js"
  },
  "keywords": [
    "cli",
    "code-review",
    "humor",
    "roast",
    "git",
    "commit",
    "code-quality",
    "ai",
    "ollama",
    "openai"
  ],
  "author": "Ankit Sharma <ankit.sharma199803@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.1.1",
    "glob": "^13.0.6",
    "meme-as-a-service": "^2.1.0",
    "node-fetch": "^3.3.2",
    "simple-git": "^3.20.0"
  },
  "optionalDependencies": {
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jest": "^29.7.0"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "scripts/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingmartinbmc/roastme.git"
  },
  "bugs": {
    "url": "https://github.com/beingmartinbmc/roastme/issues"
  },
  "homepage": "https://github.com/beingmartinbmc/roastme#readme"
}
